{
  "name": "novabase-assets",
  "private": true,
  "description": "Compilation des assets front de NovaBase (Tailwind CSS, Alpine.js CSP, polices auto-hébergées).",
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "build:vendor": "node resources/build-vendor.mjs",
    "watch": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@alpinejs/csp": "3.17.5",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "chart.js": "4.6.1",
    "qrcode-generator": "1.5.2",
    "tailwindcss": "4.3.3"
  }
}
