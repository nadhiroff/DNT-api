{
    "name": "novabase/novabase",
    "description": "NovaBase — backend auto-hébergé (base de données, API REST, auth, storage, e-mails) en PHP natif.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^6.10 || ^7.0",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-apcu": "Cache et compteurs en mémoire (rate limit, usage)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@stan",
            "@test"
        ]
    },
    "minimum-stability": "stable"
}
